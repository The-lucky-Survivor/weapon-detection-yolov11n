<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weapon Detector AI"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/media_container"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/detection_frame_neon"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/app_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/weapon"
            android:visibility="visible" />

        <VideoView
            android:id="@+id/video_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <Button
        android:id="@+id/button_start_detection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="START DETECTION"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:background="@drawable/button_rounded_blue"
        app:layout_constraintTop_toBottomOf="@id/media_container"
        app:layout_constraintStart_toStartOf="@id/media_container"
        app:layout_constraintEnd_toEndOf="@id/media_container" />

    <Button
        android:id="@+id/button_upload_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:text="UPLOAD IMAGE"
        android:drawableTop="@drawable/ic_upload"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="@android:color/white"
        android:background="@drawable/button_rounded_dark"
        app:layout_constraintTop_toBottomOf="@id/button_start_detection"
        app:layout_constraintStart_toStartOf="@id/media_container"
        app:layout_constraintEnd_toStartOf="@id/button_upload_video"
        app:layout_constraintHorizontal_weight="1" />

    <Button
        android:id="@+id/button_upload_video"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:text="UPLOAD VIDEO"
        android:drawableTop="@drawable/ic_video"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="@android:color/white"
        android:background="@drawable/button_rounded_dark"
        app:layout_constraintTop_toBottomOf="@id/button_start_detection"
        app:layout_constraintStart_toEndOf="@id/button_upload_image"
        app:layout_constraintEnd_toEndOf="@id/media_container"
        app:layout_constraintHorizontal_weight="1" />

    <Button
        android:id="@+id/button_open_camera"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="OPEN LIVE CAMERA"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:background="@drawable/button_rounded_blue"
        android:drawableStart="@drawable/ic_camera"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/button_upload_image"
        app:layout_constraintStart_toStartOf="@id/media_container"
        app:layout_constraintEnd_toEndOf="@id/media_container" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>