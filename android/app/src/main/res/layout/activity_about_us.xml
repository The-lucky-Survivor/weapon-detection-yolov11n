<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <TextView
        android:id="@+id/team_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Our Team"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/team_title"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2A2A40"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:src="@drawable/seif"
                        android:background="@drawable/button_rounded_dark"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Seif Image"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seif El-dein Ayman"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Engineer"
                        android:textColor="#00F0FF"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageButton
                            android:id="@+id/btn_m1_fb"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_facebook"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#1877F2"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="Facebook"/>

                        <ImageButton
                            android:id="@+id/btn_m1_ln"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_linkedin"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#0077B5"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="LinkedIn"/>

                        <ImageButton
                            android:id="@+id/btn_m1_gh"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_github"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#FFFFFF"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:contentDescription="GitHub"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2A2A40"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:src="@drawable/ashry"
                        android:background="@drawable/button_rounded_dark"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Ashry Image"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ibrahim Adel El-Ashry"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ML/CS Engineer"
                        android:textColor="#00F0FF"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageButton
                            android:id="@+id/btn_m2_fb"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_facebook"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#1877F2"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"/>

                        <ImageButton
                            android:id="@+id/btn_m2_ln"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_linkedin"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#0077B5"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"/>

                        <ImageButton
                            android:id="@+id/btn_m2_gh"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_github"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#FFFFFF"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2A2A40"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:src="@drawable/el_mallah"
                        android:background="@drawable/button_rounded_dark"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Melh Image"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abdallah AbdElqader El-mallah"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Science Engineer"
                        android:textColor="#00F0FF"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageButton
                            android:id="@+id/btn_m3_fb"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_facebook"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#1877F2"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"/>

                        <ImageButton
                            android:id="@+id/btn_m3_ln"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_linkedin"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#0077B5"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"/>

                        <ImageButton
                            android:id="@+id/btn_m3_gh"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_github"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#FFFFFF"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2A2A40"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:src="@drawable/ahmed"
                        android:background="@drawable/button_rounded_dark"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Modhesh Image"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ahmed Ashraf Fawzy"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CV/NLP Engineer"
                        android:textColor="#00F0FF"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageButton
                            android:id="@+id/btn_m4_fb"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_facebook"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#1877F2"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"/>

                        <ImageButton
                            android:id="@+id/btn_m4_ln"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_linkedin"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#0077B5"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"/>

                        <ImageButton
                            android:id="@+id/btn_m4_gh"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_github"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#FFFFFF"
                            android:scaleType="fitCenter"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_back_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:backgroundTint="#AB0606"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>